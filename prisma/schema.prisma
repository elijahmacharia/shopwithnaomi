generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleName {
  OWNER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  MPESA
  OTHER
  CREDIT
}

enum OrderStatus {
  NEW
  CONFIRMED
  AWAITING_PAYMENT
  PACKING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum CreditStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockMovementType {
  SALE
  STOCK_ADDITION
  MANUAL_ADJUSTMENT
  DAMAGE
  RETURN
  STOCK_TAKE
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum DamageReason {
  BROKEN
  FAULTY
  EXPIRED
  CUSTOMER_RETURN
  OTHER
}

enum ExpenseCategory {
  TRANSPORT
  DELIVERY
  ELECTRICITY
  PACKAGING
  REPAIRS
  OTHER
}

model Role {
  id    String   @id @default(cuid())
  name  RoleName @unique
  users User[]
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]

  sales              Sale[]                @relation("SaleEmployee")
  paymentsRecorded   Payment[]             @relation("PaymentRecorder")
  stockMovements     StockMovement[]       @relation("MovementUser")
  damageReports      DamageReport[]        @relation("DamageReporter")
  damageReviews      DamageReport[]        @relation("DamageReviewer")
  priceRequests      PriceChangeRequest[]  @relation("PriceRequester")
  priceReviews       PriceChangeRequest[]  @relation("PriceReviewer")
  stockTakes         StockTake[]           @relation("StockTakeUser")
  expenses           Expense[]             @relation("ExpenseUser")
  auditLogs          AuditLog[]            @relation("AuditUser")
  notifications      Notification[]        @relation("NotificationUser")
  creditPayments     CreditPayment[]       @relation("CreditPaymentUser")
  priceHistory       ProductPriceHistory[] @relation("PriceHistoryUser")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  products    Product[]
}

model Product {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  sku           String    @unique
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  description   String
  imageUrl      String?
  costPrice     Decimal   @db.Decimal(12, 2)
  sellingPrice  Decimal   @db.Decimal(12, 2)
  stockQuantity Int
  minimumStock  Int
  isActive      Boolean   @default(true)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  priceHistory ProductPriceHistory[]
  movements    StockMovement[]
  saleItems    SaleItem[]
  orderItems   OrderItem[]
  damageReports DamageReport[]
  priceRequests PriceChangeRequest[]
  stockTakeItems StockTakeItem[]

  @@index([categoryId])
  @@index([name])
}

model ProductPriceHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  oldPrice  Decimal  @db.Decimal(12, 2)
  newPrice  Decimal  @db.Decimal(12, 2)
  changedBy String
  user      User     @relation("PriceHistoryUser", fields: [changedBy], references: [id])
  reason    String
  createdAt DateTime @default(now())

  @@index([productId])
}

model StockMovement {
  id             String            @id @default(cuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  movementType   StockMovementType
  quantity       Int
  quantityBefore Int
  quantityAfter  Int
  referenceId    String?
  reason         String?
  createdBy      String?
  user           User?             @relation("MovementUser", fields: [createdBy], references: [id])
  createdAt      DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

model Customer {
  id             String   @id @default(cuid())
  name           String
  phone          String   @unique
  whatsappPhone  String?
  email          String?
  address        String?
  landmark       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sales          Sale[]
  payments       Payment[]
  credits        CreditRecord[]
  orders         Order[]

  @@index([name])
}

model Sale {
  id            String        @id @default(cuid())
  saleNumber    String        @unique
  employeeId    String
  employee      User          @relation("SaleEmployee", fields: [employeeId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  subtotal      Decimal       @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @db.Decimal(12, 2)
  balance       Decimal       @db.Decimal(12, 2)
  paymentStatus PaymentStatus
  paymentMethod PaymentMethod
  notes           String?
  clientRequestId String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         SaleItem[]
  payments      Payment[]
  credit        CreditRecord?

  @@index([employeeId, createdAt])
  @@index([createdAt])
  @@index([paymentStatus])
}

model SaleItem {
  id                String  @id @default(cuid())
  saleId            String
  sale              Sale    @relation(fields: [saleId], references: [id])
  productId         String
  product           Product @relation(fields: [productId], references: [id])
  quantity          Int
  unitPrice         Decimal @db.Decimal(12, 2)
  costPriceSnapshot Decimal @db.Decimal(12, 2)
  subtotal          Decimal @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id         String        @id @default(cuid())
  saleId     String?
  sale       Sale?         @relation(fields: [saleId], references: [id])
  customerId String?
  customer   Customer?     @relation(fields: [customerId], references: [id])
  method     PaymentMethod
  amount     Decimal       @db.Decimal(12, 2)
  reference  String?
  notes      String?
  recordedBy String
  user       User          @relation("PaymentRecorder", fields: [recordedBy], references: [id])
  createdAt  DateTime      @default(now())

  @@index([saleId])
  @@index([createdAt])
}

model CreditRecord {
  id         String        @id @default(cuid())
  saleId     String        @unique
  sale       Sale          @relation(fields: [saleId], references: [id])
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  amount     Decimal       @db.Decimal(12, 2)
  amountPaid Decimal       @db.Decimal(12, 2)
  balance    Decimal       @db.Decimal(12, 2)
  dueDate    DateTime
  status     CreditStatus
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  payments   CreditPayment[]

  @@index([status, dueDate])
  @@index([customerId])
}

model CreditPayment {
  id         String        @id @default(cuid())
  creditId   String
  credit     CreditRecord  @relation(fields: [creditId], references: [id])
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod
  reference  String?
  recordedBy String
  user       User          @relation("CreditPaymentUser", fields: [recordedBy], references: [id])
  createdAt  DateTime      @default(now())

  @@index([creditId])
}

model DamageReport {
  id          String         @id @default(cuid())
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  quantity    Int
  reason      DamageReason
  description String
  photoUrl    String?
  reportedBy  String
  reporter    User           @relation("DamageReporter", fields: [reportedBy], references: [id])
  status      ApprovalStatus @default(PENDING)
  reviewedBy  String?
  reviewer    User?          @relation("DamageReviewer", fields: [reviewedBy], references: [id])
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime       @default(now())

  @@index([status, createdAt])
}

model PriceChangeRequest {
  id             String         @id @default(cuid())
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  currentPrice   Decimal        @db.Decimal(12, 2)
  requestedPrice Decimal        @db.Decimal(12, 2)
  reason         String
  requestedBy    String
  requester      User           @relation("PriceRequester", fields: [requestedBy], references: [id])
  status         ApprovalStatus @default(PENDING)
  reviewedBy     String?
  reviewer       User?          @relation("PriceReviewer", fields: [reviewedBy], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime       @default(now())

  @@index([status, createdAt])
}

model StockTake {
  id          String           @id @default(cuid())
  createdBy   String
  user        User             @relation("StockTakeUser", fields: [createdBy], references: [id])
  status      ApprovalStatus   @default(PENDING)
  notes       String?
  createdAt   DateTime         @default(now())
  completedAt DateTime?
  items       StockTakeItem[]
}

model StockTakeItem {
  id               String    @id @default(cuid())
  stockTakeId      String
  stockTake        StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  systemQuantity   Int
  physicalQuantity Int
  difference       Int
  reason           String?

  @@index([stockTakeId])
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  notes       String?
  createdBy   String
  user        User            @relation("ExpenseUser", fields: [createdBy], references: [id])
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([date])
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])
  status          OrderStatus    @default(NEW)
  paymentStatus   PaymentStatus  @default(UNPAID)
  subtotal        Decimal        @db.Decimal(12, 2)
  deliveryFee     Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  deliveryMethod  DeliveryMethod
  deliveryAddress String?
  landmark        String?
  notes           String?
  stockApplied    Boolean        @default(true)
  clientRequestId String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           OrderItem[]
  delivery        Delivery?

  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  @@index([orderId])
}

model Delivery {
  id        String         @id @default(cuid())
  orderId   String         @unique
  order     Order          @relation(fields: [orderId], references: [id])
  status    OrderStatus
  address   String?
  landmark  String?
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation("AuditUser", fields: [userId], references: [id])
  action      String
  entityType  String
  entityId    String?
  description String
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model BusinessSetting {
  id              String   @id @default("default")
  businessName    String
  phone           String
  whatsappNumber  String
  email           String
  address         String
  openingHours    String
  receiptFooter        String
  deliveryNote         String @default("")
  pickupNote           String @default("")
  paymentInstructions  String @default("")
  lowStockDefault      Int    @default(5)
  logoUrl              String?
  updatedAt       DateTime @updatedAt
}

model Counter {
  id    String @id
  value Int    @default(0)
}

model StoredFile {
  id        String   @id @default(cuid())
  mime      String
  bytes     Bytes
  createdAt DateTime @default(now())
}
